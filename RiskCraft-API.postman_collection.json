          }
        },
        {
          "name": "Complete Challenge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gamification/challenges/1/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gamification", "challenges", "1", "complete"]
            }
          }
        },
        {
          "name": "Get Leaderboard - Consistency",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gamification/leaderboard/consistency?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gamification", "leaderboard", "consistency"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Get Leaderboard - Risk",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gamification/leaderboard/risk?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gamification", "leaderboard", "risk"],
              "query": [
                {
                  "key": "limit",
