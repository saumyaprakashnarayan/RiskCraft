<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_bg">

    <!-- TOP BAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good Morning 👋"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RiskCraft"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/leaderboardIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_bg"
                android:padding="9dp"
                android:src="@drawable/ic_orders"
                app:tint="@color/gold" />

            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/circle_bg"
                android:padding="8dp"
                android:src="@drawable/ic_profile" />
        </LinearLayout>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- WALLET CARD -->
            <LinearLayout
                android:id="@+id/walletCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wallet_card_bg"
                android:orientation="vertical"
                android:padding="22dp"
                android:layout_marginBottom="8dp"
                android:elevation="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Portfolio Value"
                    android:textColor="#E0D4FF"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/walletBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹10,00,000"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Invested"
                            android:textColor="#C4B5FD"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/investedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Returns"
                            android:textColor="#C4B5FD"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/returnsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="@color/success_light"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Available"
                            android:textColor="#C4B5FD"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/availableBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹10,00,000"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- QUICK ACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="16dp">

                <LinearLayout
                    android:id="@+id/tradeBtn"
                    style="@style/quickAction"
                    android:orientation="vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_trade" app:tint="@color/accent_primary_light" android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Trade" android:layout_marginTop="6dp" android:textSize="11sp"
                        android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/portfolioBtn"
                    style="@style/quickAction"
                    android:orientation="vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_portfolio" app:tint="@color/accent_primary_light" android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Portfolio" android:layout_marginTop="6dp" android:textSize="11sp"
                        android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ordersBtn"
                    style="@style/quickAction"
                    android:orientation="vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_orders" app:tint="@color/accent_primary_light" android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Orders" android:layout_marginTop="6dp" android:textSize="11sp"
                        android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/leaderboardBtn"
                    style="@style/quickAction"
                    android:orientation="vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_orders" app:tint="@color/gold" android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ranks" android:layout_marginTop="6dp" android:textSize="11sp"
                        android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <!-- SEARCH BOX -->
            <LinearLayout
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/text_tertiary" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Search stocks, crypto, indices..."
                    android:paddingStart="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp"
                    android:focusable="false"
                    android:clickable="true" />
            </LinearLayout>

            <!-- MARKET INDICES -->
            <TextView
                style="@style/sectionHeader"
                android:text="📊  Market Indices"/>

            <LinearLayout
                android:id="@+id/indicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"/>

            <!-- INDIAN MARKET -->
            <TextView
                style="@style/sectionHeader"
                android:text="🇮🇳  Indian Market"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/indianStocksContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <!-- CRYPTO MARKET -->
            <TextView
                style="@style/sectionHeader"
                android:text="₿  Cryptocurrency"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/cryptoContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <!-- CHALLENGES -->
            <TextView
                style="@style/sectionHeader"
                android:text="🏆  Active Challenges"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/challengesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- WATCHLIST -->
            <TextView
                style="@style/sectionHeader"
                android:text="👁  Your Watchlist"/>

            <LinearLayout
                android:id="@+id/watchlistContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

    <!-- FLOATING AI CHAT BUTTON -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAiChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="Ask AI"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:icon="@drawable/ic_send"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#3B82F6"
        app:elevation="8dp" />

</FrameLayout>
