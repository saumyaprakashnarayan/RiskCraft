<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/gradient_bg">

    <!-- Logo -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/wallet_card_bg"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:elevation="8dp">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chart"
            android:padding="2dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RiskCraft"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your 4-digit PIN to unlock"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="36dp"/>

    <!-- PIN Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hero_card_bg"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        android:elevation="4dp">

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:gravity="center"
            android:letterSpacing="1.0"
            android:textSize="28sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="• • • •"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/pinBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Unlock"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/button_bg"
            android:elevation="4dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot PIN? Log out and reset"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:layout_marginTop="24dp"/>
</LinearLayout>
