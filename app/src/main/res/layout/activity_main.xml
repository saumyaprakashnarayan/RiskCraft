<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="28dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- APP LOGO -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/wallet_card_bg"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:elevation="8dp">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chart"
                android:padding="2dp"/>
        </LinearLayout>

        <!-- APP NAME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RiskCraft"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <!-- TAGLINE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Trading Simulator"
            android:textColor="@color/accent_primary_light"
            android:textSize="14sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="40dp"/>

        <!-- FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/hero_card_bg"
            android:elevation="6dp"
            android:padding="24dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/formTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/formSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to continue trading"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="24dp"/>

            <!-- NAME (Signup only) -->
            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Full Name"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:drawablePadding="10dp"
                android:textSize="14sp"/>

            <!-- CONTACT (Signup only) -->
            <EditText
                android:id="@+id/contactInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Contact Number"
                android:padding="14dp"
                android:inputType="phone"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:textSize="14sp"/>

            <!-- AADHAAR (Signup only) -->
            <EditText
                android:id="@+id/aadhaarInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Aadhaar Number"
                android:padding="14dp"
                android:inputType="number"
                android:maxLength="12"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:textSize="14sp"/>

            <!-- PAN (Signup only) -->
            <EditText
                android:id="@+id/panInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="PAN Number"
                android:padding="14dp"
                android:inputType="textCapCharacters"
                android:maxLength="10"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:textSize="14sp"/>

            <!-- GENDER (Signup only) -->
            <Spinner
                android:id="@+id/genderSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"
                android:padding="14dp"
                android:visibility="gone" />

            <!-- OCCUPATION (Signup only) -->
            <EditText
                android:id="@+id/occupationInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Occupation"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:textSize="14sp"/>

            <!-- DOB (Signup only) -->
            <EditText
                android:id="@+id/dobInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Date of Birth"
                android:padding="14dp"
                android:focusable="false"
                android:clickable="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:textSize="14sp"/>

            <!-- EMAIL -->
            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Email Address"
                android:padding="14dp"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"
                android:textSize="14sp"/>

            <!-- PASSWORD -->
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Password"
                android:padding="14dp"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="24dp"
                android:textSize="14sp"/>

            <!-- ACTION BUTTON -->
            <Button
                android:id="@+id/actionButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Sign In"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/button_bg"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"/>

            <!-- SWITCH TEXT -->
            <TextView
                android:id="@+id/switchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Don't have an account? Sign Up"
                android:textColor="@color/accent_primary_light"
                android:textSize="13sp"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- DEMO INFO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 Practice trading with virtual RC Coins"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start with ₹10,00,000 | Real Market Data"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
