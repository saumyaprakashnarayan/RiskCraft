<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CENTER CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:orientation="vertical">

            <!-- HERO CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/hero_card_bg"
                android:elevation="10dp"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unleash the Power of"
                    android:textColor="#E5E7EB"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <!-- MARKET -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MARKET"
                    android:textColor="#8A7CFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="24dp"/>

                <!-- NAME (Signup only) -->
                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Full Name"
                    android:padding="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="#9AA4B2"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <!-- CONTACT -->
                <EditText
                    android:id="@+id/contactInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Contact Number"
                    android:padding="14dp"
                    android:inputType="phone"
                    android:textColor="@color/white"
                    android:textColorHint="#9AA4B2"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <!-- AADHAAR -->
                <EditText
                    android:id="@+id/aadhaarInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Aadhaar Number"
                    android:padding="14dp"
                    android:inputType="number"
                    android:maxLength="12"
                    android:textColor="@color/white"
                    android:textColorHint="#9AA4B2"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <!-- PAN (Signup only) -->
                <EditText
                    android:id="@+id/panInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="PAN Number"
                    android:padding="14dp"
                    android:inputType="textCapCharacters"
                    android:maxLength="10"
                    android:textColor="@color/white"
                    android:textColorHint="#9AA4B2"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <!-- GENDER (Signup only) -->
                <Spinner
                    android:id="@+id/genderSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="16dp"
                    android:padding="14dp"
                    android:visibility="gone" />

                <!-- OCCUPATION (Signup only) -->
                <EditText
                    android:id="@+id/occupationInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Occupation"
                    android:padding="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="#9AA4B2"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <!-- DOB (Signup only) -->
                <EditText
                    android:id="@+id/dobInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Date of Birth"
                    android:padding="14dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/white"
                    android:textColorHint="#9AA4B2"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <!-- EMAIL -->
                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Email"
                    android:padding="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="#9AA4B2"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="16dp"/>

                <!-- PASSWORD -->
                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Password"
                    android:padding="14dp"
                    android:inputType="textPassword"
                    android:textColor="@color/white"
                    android:textColorHint="#9AA4B2"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="24dp"/>

                <!-- BUTTON -->
                <Button
                    android:id="@+id/actionButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Login"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#0B0E11"
                    android:background="@drawable/button_bg"
                    android:layout_marginBottom="18dp"/>

                <!-- SWITCH -->
                <TextView
                    android:id="@+id/switchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? Sign Up"
                    android:textColor="#B8B2FF"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
