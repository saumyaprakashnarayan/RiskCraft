<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Section Header -->
    <style name="sectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Segment tabs -->
    <style name="segmentTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/accent_primary_light</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- Quick Action Button -->
    <style name="quickAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/card_dark_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- Stock row -->
    <style name="stockRow">
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/hero_card_bg</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Index chip style -->
    <style name="indexStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/hero_card_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Profile screen item -->
    <style name="profileItem">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

</resources>
